{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview --host",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:health": "node scripts/maintenance/db-health-check.cjs",
    "db:seed": "node scripts/seed/seed-academic-data.cjs",
    "db:validate-constraints": "node scripts/ci/validate-constraints.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t hteim-school-of-ministry .",
    "docker:run": "docker run -d -p 3000:3000 --name hteim-school-of-ministry hteim-school-of-ministry",
    "docker:compose": "docker compose up --build -d"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.16.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^4.10.38",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "redis": "^6.2.1",
    "sonner": "^2.0.8",
    "string-similarity": "^4.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vercel": "^54.17.3",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/string-similarity": "^4.0.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.10"
  }
}
